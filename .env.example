# Society Speaks – core environment variables
# Copy to .env and fill in real values. Never commit .env.

# Required
SECRET_KEY=your_secret_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/society_speaks
REDIS_URL=redis://localhost:6379/0

# Optional – error tracking
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=local-dev
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Keep profiling off on gunicorn+gevent web workers (default). Opt in only
# on a sync process when investigating a specific endpoint.
# SENTRY_PROFILES_SAMPLE_RATE=0
# SENTRY_CONTINUOUS_PROFILING=false

# Optional – app URL (defaults to https://societyspeaks.io; used by sitemap.xml and robots.txt)
# APP_BASE_URL=https://your-domain.com

# Optional – sitemap: minimum visible statements for native discussions (default 3; set 1 or 0 to loosen)
# SITEMAP_MIN_STATEMENTS=3

# Environment
FLASK_ENV=development

# Deployment role (web | scheduler | worker). Unset = legacy single-process mode.
# APP_ROLE=web         → disables scheduler (set on Autoscale web deployments)
# APP_ROLE=scheduler   → runs scheduler only, no web serving (Reserved VM singleton)
# APP_ROLE=worker      → disables scheduler, enables consensus execution (Reserved VM)
# APP_ROLE=

# Scheduler only: seconds before a clean self-exit for platform restart (0 = never).
# Leave unset/0 on Render. Non-zero was a Replit memory workaround and triggers
# "Application exited early" alerts when the platform restarts the worker.
# SCHEDULER_MAX_RUNTIME_SECONDS=0

# Consensus oversize stability (safe defaults)
# Keep MIN_STABILITY_RUNS <= STABILITY_RUNS to avoid withholding all oversize analyses.
# MAX_CONSENSUS_OVERSIZE_SAMPLE_STATEMENTS=500
# MAX_CONSENSUS_OVERSIZE_SAMPLE_PARTICIPANTS=5000
# CONSENSUS_OVERSIZE_STABILITY_RUNS=5
# CONSENSUS_OVERSIZE_MIN_STABILITY_RUNS=3
# CONSENSUS_OVERSIZE_MIN_STABILITY_ARI=0.30

# Optional – Cloudflare Turnstile on /auth/register (math captcha is the fallback)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional – unsolicited-content scoring and ops paging
# CONTENT_SPAM_SCORE_THRESHOLD=6
# CONTENT_SPAM_ALERT_THRESHOLD=8

# For Daily Brief, email, Stripe, and partner API vars see .env.brief.example

# Self-serve consultations (one question, one audience, one report).
# Off by default: /consultations/self-serve, /consultations/... and /c/<token> answer 404.
# CONSULTATIONS_SELF_SERVE_ENABLED=true
# Prices in pence, ex VAT. Set a Stripe Price id to use one Stripe product instead of inline amounts.
# CONSULTATION_PRICE_SINGLE_PENCE=9900
# CONSULTATION_PRICE_ANNUAL_PENCE=60000
# CONSULTATION_TRIAL_DAYS=14
# Live and test Price ids differ. See OPS.md. Leave unset to bill the amounts above.
# CONSULTATION_STRIPE_PRICE_SINGLE=price_...
# CONSULTATION_STRIPE_PRICE_ANNUAL=price_...
# Turn on once VAT registered and Stripe Tax is configured.
# STRIPE_AUTOMATIC_TAX_ENABLED=true
# Model for drafting, screening and report narrative (default claude-opus-5-5). Needs ANTHROPIC_API_KEY.
# PLATFORM_LLM_MODEL=claude-opus-5-5
# A public discussion id whose results are shown at /consultations/example-report.
# CONSULTATION_EXAMPLE_DISCUSSION_ID=25

msgstr "1. 정의"

#: app/templates/terms-and-conditions.html:22
msgid "\"Platform\" means the SocietySpeaks.io website and all related services"
msgstr "\"플랫폼\"은 SocietySpeaks.io 웹사이트 및 모든 관련 서비스를 의미합니다"

#: app/templates/terms-and-conditions.html:23
msgid ""
"\"Discussion Platform\" means the discussion and collective intelligence "
"features of SocietySpeaks.io"
msgstr "“토론 플랫폼”이란 SocietySpeaks.io의 토론 및 집단 지성 기능을 의미합니다"

#: app/templates/terms-and-conditions.html:24
msgid "\"Service\" means all services provided through SocietySpeaks.io"
msgstr "\"서비스\"는 SocietySpeaks.io를 통해 제공되는 모든 서비스를 의미합니다"

#: app/templates/terms-and-conditions.html:25
msgid "\"User\", \"you\", or \"your\" means any person accessing or using the Platform"
msgstr "\"사용자\", \"귀하\" 또는 \"귀하의\"는 플랫폼에 접근하거나 사용하는 모든 사람을 의미합니다"

#: app/templates/terms-and-conditions.html:26
msgid ""
"\"Content\" means any information, text, comments, votes, or other materials"

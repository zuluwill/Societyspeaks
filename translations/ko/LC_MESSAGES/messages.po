#: app/templates/discussions/consensus_results.html:471
#, python-format
msgid "Wilson 95%% score interval."
msgstr "Wilson 95%% 점수 간격."

#: app/templates/discussions/consensus_results.html:488
msgid ""
"Statements where every group lands on the same side (either all agree or all"

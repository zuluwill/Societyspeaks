#: app/templates/consultations/statements.html:43
#: app/templates/discussions/_guided_journey_rail.html:57
#: app/templates/partner/portal/discussion_detail.html:208
#, python-format
msgid "%(num)d statement"
msgid_plural "%(num)d statements"
msgstr[0] "%(num)d개 진술"

#: app/templates/consultations/participate.html:58
msgid "Your answer to this statement"
msgstr "이 진술에 대한 내 응답"

#: app/templates/consultations/participate.html:67
msgid "Skip this one"
msgstr "이 진술 건너뛰기"

#: app/templates/consultations/participate.html:71
msgid "We could not save your last answer. Check your connection."
msgstr "마지막 응답을 저장하지 못했습니다. 연결 상태를 확인해 주세요."

#: app/templates/consultations/participate.html:72
#: app/templates/consultations/report_pending.html:20
msgid "Try again"
msgstr "다시 시도"

#: app/templates/consultations/participate.html:83
msgid "That is all your audience has to do."
msgstr "청중이 해야 할 일은 이것이 전부입니다."

#: app/templates/consultations/participate.html:84
msgid ""
"No login, no app, and nothing recorded here. Now see what the organiser gets"
" back."
msgstr "로그인도, 앱도 없고 여기에는 아무것도 기록되지 않습니다. 이제 주최자가 무엇을 받는지 확인해 보세요."

#: app/templates/consultations/participate.html:86
msgid "See the report this produces"
msgstr "이렇게 만들어지는 보고서 보기"

#: app/templates/consultations/participate.html:87
msgid "Start your own, free"
msgstr "무료로 직접 시작하기"

#: app/templates/consultations/participate.html:91
msgid "Thank you. Your answers are in."
msgstr "감사합니다. 응답이 제출되었습니다."

#: app/templates/consultations/participate.html:92
#, python-format
msgid ""
"%(organisation)s will see the overall results, never who answered what."
msgstr "%(organisation)s은 전체 결과만 볼 수 있으며, 누가 무엇을 답했는지는 알 수 없습니다."

#: app/templates/consultations/participate.html:93
#: app/templates/consultations/participate.html:123
#: app/templates/consultations/participate_unavailable.html:31
msgid "Made with"
msgstr "제작:"

#: app/templates/consultations/participate.html:94
msgid "Change an answer"
msgstr "응답 변경"

#: app/templates/consultations/participate.html:100
msgid "How others have answered so far"
msgstr "지금까지 다른 사람들의 응답"

#: app/templates/consultations/participate.html:107
msgid "Is something missing?"
msgstr "빠진 것이 있나요?"

#: app/templates/consultations/participate.html:108
msgid ""
"Suggest a statement for others to vote on. Keep it to one idea. The "
"organiser reviews every suggestion before it is shown."
msgstr "다른 사람들이 투표할 진술을 제안해 주세요. 하나의 생각만 담아 주세요. 주최자가 모든 제안을 검토한 후에 표시됩니다."

#: app/templates/consultations/participate.html:110
msgid "Your statement"
msgstr "내 진술"

#: app/templates/consultations/participate.html:114
msgid "Send suggestion"
msgstr "제안 보내기"

#: app/templates/consultations/participate.html:122
msgid ""
"Your answers are stored against a random ID on this device, not your name or"

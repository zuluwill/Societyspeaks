msgstr "참여자 상한이 있는 플랜"

#: app/templates/consultations/landing.html:695
msgid "Presenter seat"
msgstr "발표자 좌석"

#: app/templates/consultations/landing.html:695
msgid "Seat, often with a limit on responses"
msgstr "좌석, 응답 수 제한이 있는 경우가 많음"

#: app/templates/consultations/landing.html:695
#, python-format
msgid "%(price)s for 30 days, any number of participants"
msgstr "30일에 %(price)s, 참여자 수 제한 없음"

#: app/templates/consultations/landing.html:696

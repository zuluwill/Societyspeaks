msgstr "コスト"

#: app/templates/daily/_reason_input.html:51
#: app/templates/daily/confirm_vote.html:83
#: app/templates/daily/weekly_batch.html:198
msgid "Feasibility"
msgstr "実現可能性"

#: app/templates/daily/_reason_input.html:52
#: app/templates/daily/confirm_vote.html:84
#: app/templates/daily/weekly_batch.html:199
msgid "Rights"
msgstr "権利"

#: app/templates/daily/_reason_input.html:53
#: app/templates/daily/confirm_vote.html:85
#: app/templates/daily/weekly_batch.html:200
msgid "Safety"
msgstr "安全性"

#: app/templates/daily/_reason_input.html:55
#: app/templates/daily/confirm_vote.html:87
#: app/templates/daily/weekly_batch.html:202
msgid "Long-term impact"
msgstr "長期的影響"

#: app/templates/daily/_reason_input.html:56
#: app/templates/daily/confirm_vote.html:88
#: app/templates/daily/results.html:825
#: app/templates/daily/weekly_batch.html:203
msgid "Other"
msgstr "その他"

#: app/templates/daily/_reason_input.html:62
msgid "Add a short reason (optional)"
msgstr "簡潔な理由を追加（任意）"

#: app/templates/daily/_reason_input.html:66
msgid "Share why you feel this way... (max 500 characters)"
msgstr "あなたの考えを教えてください...（最大500文字）"

#: app/templates/daily/_reason_input.html:68
#: app/templates/daily/confirm_vote.html:98
msgid "/500 characters"
msgstr "/500文字"


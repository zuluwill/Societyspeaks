msgstr "Licentie, vaak met een limiet op reacties"

#: app/templates/consultations/landing.html:695
#, python-format
msgid "%(price)s for 30 days, any number of participants"
msgstr "%(price)s voor 30 dagen, elk aantal deelnemers"

#: app/templates/consultations/landing.html:696
msgid "Choose it when"
msgstr "Kies het als"

#: app/templates/consultations/landing.html:696
msgid "You want the audience’s questions, voted up"
msgstr "Je de vragen van het publiek wilt, omhoog gestemd"

#: app/templates/consultations/landing.html:696
msgid "You want a lively, interactive presentation"
msgstr "Je een levendige, interactieve presentatie wilt"

#: app/templates/consultations/landing.html:696
msgid "You need detailed answers from each person"
msgstr "Je gedetailleerde antwoorden van elke persoon nodig hebt"

#: app/templates/consultations/landing.html:696
msgid "You have a decision to make and need to know where people stand"
msgstr "Je een besluit moet nemen en moet weten waar mensen staan"

#: app/templates/consultations/landing.html:698
#: app/templates/consultations/landing.html:708

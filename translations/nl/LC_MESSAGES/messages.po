#: app/templates/partner/portal/getting_started.html:10
msgid "Setup guide"
msgstr "Installatiehandleiding"

#: app/templates/partner/portal/_portal_nav.html:38
msgid "Admin preview &middot; Exit"
msgstr "Adminvoorbeeld &middot; Afsluiten"

#: app/templates/partner/portal/accept_invite.html:3
msgid "Accept Partner Invite - Society Speaks"
msgstr "Partner-uitnodiging accepteren - Society Speaks"

#: app/templates/partner/portal/accept_invite.html:9
#, python-format
msgid "Join %(partner_name)s"
msgstr "Sluit u aan bij %(partner_name)s"

#: app/templates/partner/portal/accept_invite.html:10
msgid "Set your password to access the Partner Portal."
msgstr "Stel uw wachtwoord in voor toegang tot het Partner Portal."

#: app/templates/partner/portal/accept_invite.html:19
msgid "Full name"
msgstr "Volledige naam"

#: app/templates/partner/portal/accept_invite.html:26
msgid "Accepting…"
msgstr "Accepteren…"

#: app/templates/partner/portal/dashboard.html:3
msgid "Partner Portal - Society Speaks"
msgstr "Partner Portal - Society Speaks"

#: app/templates/partner/portal/dashboard.html:11
msgid "Integration health, API activity, and account settings."
msgstr "Integratiestatus, API-activiteit en accountinstellingen."

#: app/templates/partner/portal/dashboard.html:16
msgid "Your new API key (shown once)"
msgstr "Uw nieuwe API-sleutel (slechts eenmaal weergegeven)"

#: app/templates/partner/portal/dashboard.html:21
msgid "Copy and store this key now. For security, it will not be shown again."
msgstr ""
"Kopieer en sla deze sleutel nu op. Voor de veiligheid wordt deze niet "
"opnieuw weergegeven."

#: app/templates/partner/portal/dashboard.html:26
msgid "Your new webhook signing secret (shown once)"
msgstr "Uw nieuwe webhook-ondertekenimgsgeheim (slechts eenmaal weergegeven)"

#: app/templates/partner/portal/dashboard.html:31
msgid ""
"Store this secret securely in your webhook receiver. It will not be shown "
"again."
msgstr ""
"Sla dit geheim veilig op in uw webhook-ontvanger. Het wordt niet opnieuw "
"weergegeven."

#: app/templates/partner/portal/dashboard.html:36
msgid ""
"Admin preview mode (read-only) — you are viewing this portal as the partner "
"owner."
msgstr ""
"Beheerdervoorbeeldmodus (alleen-lezen) — u bekijkt deze portal als "
"partnereigenaar."

#: app/templates/partner/portal/dashboard.html:42
msgid "What should I do next?"
msgstr "Wat moet ik nu doen?"

#: app/templates/partner/portal/dashboard.html:44
msgid "Add and verify a test domain first so your embed can load on staging."
msgstr ""
"Voeg eerst een testdomein toe en verifieer dit, zodat uw embed op staging "
"kan worden geladen."

#: app/templates/partner/portal/dashboard.html:45
msgid "Go to Domains ↓"
msgstr "Ga naar Domeinen ↓"

#: app/templates/partner/portal/dashboard.html:47
msgid "Create a test API key to run your first lookup/create calls."
msgstr ""
"Maak een test-API-sleutel aan om uw eerste lookup/create-aanroepen uit te "
"voeren."

#: app/templates/partner/portal/dashboard.html:48
msgid "Go to API keys ↓"
msgstr "Ga naar API-sleutels ↓"

#: app/templates/partner/portal/dashboard.html:50
msgid "Run your first backend API call using the quickstart examples below."
msgstr ""
"Voer uw eerste backend-API-aanroep uit met behulp van de quickstart-"
"voorbeelden hieronder."

#: app/templates/partner/portal/dashboard.html:51
msgid "Go to Quickstart ↓"
msgstr "Ga naar Quickstart ↓"

#: app/templates/partner/portal/dashboard.html:53
msgid ""
"Your test setup is ready. Choose a plan to activate live keys and production"
" usage."

msgstr ""
"Schakel automatische insluiting van Society Speaks discussies in platforms "
"die oEmbed ondersteunen in."

#: app/templates/partner/api_docs.html:782
msgid "Society Speaks discussion URL"
msgstr "URL van Society Speaks discussie"

#: app/templates/partner/api_docs.html:787
msgid "Maximum embed width"
msgstr "Maximale insluitingsbreedte"

#: app/templates/partner/api_docs.html:792
msgid "Maximum embed height"
msgstr "Maximale insluitingshoogte"

#: app/templates/partner/api_docs.html:797
msgid "Response format (only \"json\" supported)"
msgstr "Responsindeling (alleen \"json\" ondersteund)"

#: app/templates/partner/api_docs.html:831
msgid ""
"<strong>Auto-discovery:</strong> Discussion pages include a <code>&lt;link "
"rel=\"alternate\" type=\"application/json+oembed\"&gt;</code> tag for "
"automatic oEmbed discovery by compatible platforms."
msgstr ""

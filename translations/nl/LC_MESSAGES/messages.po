#: app/templates/discussions/view_statement.html:65
#: app/templates/discussions/view_statement.html:228
msgid "Anonymous"
msgstr "Anoniem"

#: app/templates/consultations/landing.html:820
msgid "No accounts and no names. You see results, never who answered what."
msgstr ""
"Geen accounts en geen namen. Jij ziet resultaten, nooit wie wat antwoordde."

#: app/templates/consultations/landing.html:821
msgid "Link-only"
msgstr "Alleen via link"

#: app/templates/consultations/landing.html:821
msgid ""
"Never listed or searchable. Replace the link at any time and the old one "

#: app/templates/consultations/landing.html:692
msgid "A written report you can forward as it is"
msgstr "Een geschreven rapport dat je ongewijzigd kunt doorsturen"

#: app/templates/consultations/landing.html:693
msgid "Divided, or just undecided?"
msgstr "Verdeeld, of gewoon onbeslist?"

#: app/templates/consultations/landing.html:693
msgid "Yours to work out from the charts"
msgstr "Aan jou om uit de grafieken te halen"

#: app/templates/consultations/landing.html:693
msgid "Yours to work out from the data"
msgstr "Aan jou om uit de data te halen"

#: app/templates/consultations/landing.html:693
msgid "Shown separately for every statement"
msgstr "Per stelling apart getoond"

#: app/templates/consultations/landing.html:694

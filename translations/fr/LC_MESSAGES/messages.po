msgstr "Modération à temps plein requise"

#: app/templates/partner/hub.html:562
msgid "Nothing citable for follow-up reporting"
msgstr "Rien de citable pour les reportages en suivi"

#: app/templates/partner/hub.html:573
msgid "Every reader's vote counts equally"
msgstr "Le vote de chaque lecteur compte équitablement"

#: app/templates/partner/hub.html:579
msgid "Consensus, division, and bridge ideas &mdash; quantified"
msgstr "Consensus, division et idées de convergence &mdash; quantifiés"

#: app/templates/partner/hub.html:585

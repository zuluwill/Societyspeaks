msgid ""
"Headers include <code>X-SocietySpeaks-Event-Id</code> and "
"<code>X-SocietySpeaks-Signature</code>."
msgstr ""
"Les en-têtes incluent <code>X-SocietySpeaks-Event-Id</code> et "
"<code>X-SocietySpeaks-Signature</code>."


#: app/templates/briefing/sources.html:39
#: app/templates/briefing/sources.html:90
#: app/templates/privacy-policy.html:153
msgid "Name"
msgstr "Nom"

#: app/templates/privacy-policy.html:154 app/templates/security.html:43
msgid "Location"
msgstr "Localisation"

#: app/templates/privacy-policy.html:155 app/templates/security.html:87
msgid "Purpose"
msgstr "Objectif"

#: app/templates/privacy-policy.html:161 app/templates/security.html:93
msgid "Germany (EEA)"
msgstr "Allemagne (EEE)"

#: app/templates/privacy-policy.html:162 app/templates/security.html:68
#: app/templates/security.html:93
msgid "Application hosting"
msgstr "Hébergement de l’application"

#: app/templates/privacy-policy.html:166 app/templates/privacy-policy.html:171
#: app/templates/privacy-policy.html:176 app/templates/security.html:92
#: app/templates/security.html:94 app/templates/security.html:95
msgid "United Kingdom"
msgstr "Royaume-Uni"

#: app/templates/privacy-policy.html:167
msgid "Primary database (PostgreSQL)"
msgstr "Base de données principale (PostgreSQL)"

#: app/templates/privacy-policy.html:172
msgid "File storage and database backups"
msgstr "Stockage de fichiers et sauvegardes de la base de données"

#: app/templates/privacy-policy.html:177
msgid "Transient cache, sessions and rate limiting (Redis)"
msgstr "Cache transitoire, sessions et limitation de débit (Redis)"


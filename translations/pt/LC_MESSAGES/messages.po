msgstr "Artigos acadêmicos, livros, relatórios"

#: app/templates/help/native_system.html:332
msgid "🔗 URLs"
msgstr "🔗 URLs"

#: app/templates/help/native_system.html:334
msgid "Links to articles, studies, or websites"
msgstr "Links para artigos, estudos ou sites"

#: app/templates/help/native_system.html:338
msgid "📎 File Uploads"
msgstr "📎 Envio de Arquivos"

#: app/templates/help/native_system.html:339
msgid "PDFs, images, or documents"
msgstr "PDFs, imagens ou documentos"

#: app/templates/help/native_system.html:343
msgid ""
"💡 Evidence can be marked as <strong>verified</strong>, "
"<strong>pending</strong>, or <strong>disputed</strong> by moderators."
msgstr ""
"💡 Evidências podem ser marcadas como <strong>verificadas</strong>, "
"<strong>pendentes</strong> ou <strong>contestadas</strong> por moderadores."

#: app/templates/help/native_system.html:349
msgid "Moderation & Safety"
msgstr "Moderação e Segurança"

#: app/templates/help/native_system.html:352
msgid "We maintain high-quality discussions through:"
msgstr "Mantemos discussões de alta qualidade por meio de:"

#: app/templates/help/native_system.html:356
msgid ""

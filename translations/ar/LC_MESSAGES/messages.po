msgstr "هل تريد إغلاق التصويت الآن وإعداد التقرير؟"

#: app/templates/consultations/dashboard.html:173
msgid "Close now and build the report"
msgstr "أغلق الآن وأعدّ التقرير"

#: app/templates/consultations/dashboard.html:177

msgstr "عيّن كلمة المرور الخاصة بك للوصول إلى بوابة الشركاء."

#: app/templates/partner/portal/accept_invite.html:19
msgid "Full name"
msgstr "الاسم الكامل"

#: app/templates/partner/portal/accept_invite.html:26
msgid "Accepting…"
msgstr "جاري القبول…"


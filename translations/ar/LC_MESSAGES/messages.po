msgstr ""
"يتم إنشاء عنوان نقاش محايد وبيانات بذر متوازنة لتأطير النقاش بشكل عادل."

#: app/templates/help/news_feed.html:223
msgid "Quality Checks"
msgstr "فحوصات الجودة"

#: app/templates/help/news_feed.html:224

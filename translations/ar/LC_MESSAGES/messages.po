#: app/templates/consultations/go_live.html:46
#: app/templates/consultations/go_live.html:59
msgid "Going live…"
msgstr "جارٍ الإطلاق…"

#: app/templates/consultations/go_live.html:46
msgid "Go live now"
msgstr "أطلِق الآن"

#: app/templates/consultations/go_live.html:48
msgid ""
"After this, statements cannot be reworded. You can still withdraw one or add"
" more."
msgstr ""
"بعد ذلك لا يمكن إعادة صياغة التصريحات. ويمكنك مع ذلك سحب تصريح أو إضافة "

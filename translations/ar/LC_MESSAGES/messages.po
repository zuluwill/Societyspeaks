#: app/templates/consultations/participate_unavailable.html:22
#, python-format
msgid ""
"Thank you to everyone who took part. %(organisation)s now has the results."
msgstr "شكرًا لكل من شارك. أصبحت النتائج لدى %(organisation)s الآن."

#: app/templates/consultations/participate_unavailable.html:24
msgid "Nothing to answer yet"
msgstr "لا شيء للإجابة عنه بعد"

#: app/templates/consultations/participate_unavailable.html:25

msgid "Could not create the discussion — a duplicate may already exist."
msgstr "चर्चा नहीं बना सकें — एक डुप्लिकेट पहले से मौजूद हो सकता है।"

#: app/partner/routes.py:1164
#, python-format
msgid "Discussion \"%(title)s\" created successfully (ID %(id)s)."
msgstr "चर्चा \"%(title)s\" सफलतापूर्वक बनाई गई (ID %(id)s)।"

#: app/partner/routes.py:1174
msgid "You do not have permission to open or close discussions."
msgstr "आपको चर्चाएँ खोलने या बंद करने की अनुमति नहीं है।"


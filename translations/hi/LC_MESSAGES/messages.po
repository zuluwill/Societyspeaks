#: app/daily/routes.py:1209
msgid "Your preferences have been updated successfully."
msgstr "आपकी प्राथमिकताएं सफलतापूर्वक अपडेट की गई हैं।"

#: app/daily/routes.py:1213
msgid "There was an error saving your preferences. Please try again."
msgstr "आपकी प्राथमिकताओं को सहेजने में त्रुटि हुई। कृपया पुनः प्रयास करें।"

#: app/daily/routes.py:1257
msgid "Please use the link from your weekly digest email to access this page."
msgstr ""
"इस पृष्ठ को एक्सेस करने के लिए कृपया अपने साप्ताहिक डाइजेस्ट ईमेल से लिंक का"
" उपयोग करें।"

#: app/daily/routes.py:1305
msgid "No questions available for this week yet."
msgstr "इस हफ्ते के लिए अभी कोई सवाल उपलब्ध नहीं है।"

#: app/daily/routes.py:1436
msgid "Not authenticated"
msgstr "प्रमाणित नहीं"

#: app/daily/routes.py:1440
msgid "Subscriber not found or inactive"
msgstr "सदस्य नहीं मिला या निष्क्रिय है"

#: app/daily/routes.py:1456
msgid "Content-Type must be application/json"
msgstr "Content-Type application/json होना चाहिए"

#: app/daily/routes.py:1468
msgid "Missing question_id or vote"
msgstr "question_id या vote गायब है"

#: app/daily/routes.py:1472
msgid "Invalid vote"
msgstr "अमान्य वोट"

#: app/daily/routes.py:1481
msgid "Already voted"
msgstr "पहले से ही वोट किया जा चुका है"

#: app/daily/routes.py:1612
msgid "Failed to record vote"
msgstr "वोट रिकॉर्ड करने में विफल"

#: app/daily/routes.py:1658
msgid "Invalid vote option."
msgstr "अमान्य वोट विकल्प।"

#: app/daily/routes.py:1739
msgid "This question is no longer available."
msgstr "यह सवाल अब उपलब्ध नहीं है।"

#: app/daily/routes.py:1745
msgid "This question isn't available yet. Please check back later."
msgstr "यह सवाल अभी उपलब्ध नहीं है। कृपया बाद में देखें।"

#: app/daily/routes.py:1750
#, python-format
msgid ""
"This question expired on %(question_date)s. Please check today's question!"
msgstr "यह सवाल %(question_date)s को समाप्त हो गया। कृपया आज का सवाल देखें!"

#: app/daily/routes.py:1755
msgid "You have already voted on this question."
msgstr "आप पहले से ही इस सवाल पर वोट कर चुके हैं।"


msgstr "Admin पूर्वावलोकन केवल-पढ़ने वाला है।"

#: app/partner/routes.py:1199
#, python-format
msgid "Discussion #%(discussion_id)s %(action)s."
msgstr "चर्चा #%(discussion_id)s %(action)s।"


#: app/auth/routes.py:258 app/auth/routes.py:728
#, python-format
msgid "Welcome to %(org_name)s! You now have access to the team's briefings."
msgstr "%(org_name)s में स्वागत है! अब आपको टीम के briefings तक पहुंच है।"

#: app/auth/routes.py:275
msgid "You're signed in. Opening secure checkout..."
msgstr "आप साइन इन हैं। सुरक्षित चेकआउट खुल रहा है..."

#: app/auth/routes.py:358
msgid "Discussion saved. We will keep it handy in your dashboard."
msgstr "चर्चा सहेजी गई। हम इसे आपके dashboard में रखेंगे।"

#: app/auth/routes.py:519 app/auth/routes.py:701
msgid "Email confirmed. Your account is ready."
msgstr "ईमेल की पुष्टि हो गई। आपका खाता तैयार है।"

#: app/auth/routes.py:521
msgid "Your email is already confirmed. Please log in."
msgstr "आपके ईमेल की पुष्टि पहले ही हो चुकी है। कृपया लॉग इन करें।"

#: app/auth/routes.py:568
msgid "If that address is waiting for confirmation, a new link has been sent."
msgstr "अगर वह पता पुष्टि की प्रतीक्षा में है, तो नया लिंक भेज दिया गया है।"

#: app/auth/routes.py:629
msgid "This email already has an account. Please log in."
msgstr "इस ईमेल से पहले से एक खाता मौजूद है। कृपया लॉग इन करें।"

#: app/auth/routes.py:634
msgid ""
"That username was taken while you were confirming. Please choose another and"
" we will send a new link."
msgstr ""
"पुष्टि करते समय वह यूज़रनेम किसी और ने ले लिया। कृपया कोई दूसरा चुनें, हम "
"नया लिंक भेज देंगे।"

#: app/auth/routes.py:662
msgid ""
"We could not finish creating your account. Please try registering again."
msgstr ""
"हम आपका खाता बनाने का काम पूरा नहीं कर सके। कृपया दोबारा पंजीकरण करने का "
"प्रयास करें।"

#: app/auth/routes.py:719
msgid "This invitation link is invalid or has expired."
msgstr "यह आमंत्रण लिंक अमान्य है या समाप्त हो गया है।"

#: app/auth/routes.py:739
#, python-format
msgid ""
"You've been invited to join %(org_name)s. Please log in or create an account"
" to accept."
msgstr ""
"आपको %(org_name)s में शामिल होने के लिए आमंत्रित किया गया है। कृपया लॉगिन "
"करें या खाता बनाएं।"

#: app/auth/routes.py:817
msgid "All fields are required."
msgstr "सभी फील्ड आवश्यक हैं।"

#: app/auth/routes.py:820
msgid "Username must be at least 2 characters."
msgstr "यूज़रनेम कम से कम 2 अक्षरों का होना चाहिए।"

#: app/auth/routes.py:823 app/settings/forms.py:9
msgid "Password must be at least 8 characters."
msgstr "पासवर्ड कम से कम 8 वर्ण होना चाहिए।"

#: app/auth/routes.py:830
msgid "Please complete the human verification and try again."
msgstr "कृपया मानव सत्यापन पूरा करें और फिर प्रयास करें।"

#: app/auth/routes.py:837
msgid "Session expired. Please try again."
msgstr "सत्र समाप्त हो गया। कृपया पुनः प्रयास करें।"

#: app/auth/routes.py:840
msgid "Please answer the verification question."
msgstr "कृपया सत्यापन प्रश्न का उत्तर दें।"

#: app/auth/routes.py:845 app/auth/routes.py:848
msgid "Incorrect verification answer. Please try again."
msgstr "गलत सत्यापन उत्तर। कृपया पुनः प्रयास करें।"

#: app/auth/routes.py:852
msgid "Please provide a valid email address."
msgstr "कृपया एक वैध ईमेल पता प्रदान करें।"

#: app/auth/routes.py:858
msgid "Please use a lasting email address so we can reach you."
msgstr "कृपया कोई स्थायी ईमेल पता इस्तेमाल करें ताकि हम आप तक पहुँच सकें।"

#: app/auth/routes.py:866
msgid "Registration denied due to suspicious content"
msgstr "संदिग्ध सामग्री के कारण पंजीकरण अस्वीकार किया गया"

#: app/auth/routes.py:869
msgid "Email already registered. Please log in."
msgstr "ईमेल पहले से पंजीकृत है। कृपया लॉगिन करें।"

#: app/auth/routes.py:872 app/auth/routes.py:881
msgid "That username is already taken. Please choose another."
msgstr "वह यूज़रनेम पहले से लिया जा चुका है। कृपया कोई दूसरा चुनें।"

#: app/auth/routes.py:905
msgid ""
"That username or email is already registered. Please log in or choose "
"another."
msgstr ""
"वह यूज़रनेम या ईमेल पहले से पंजीकृत है। कृपया लॉग इन करें या कोई दूसरा "
"चुनें।"

#: app/auth/routes.py:972
#, python-format
msgid ""
"Confirm your email to finish creating your account. We sent a link to "
"%(email)s."
msgstr ""
"खाता बनाना पूरा करने के लिए अपने ईमेल की पुष्टि करें। हमने %(email)s पर एक "
"लिंक भेजा है।"

#: app/auth/routes.py:982 app/lib/partner_portal_session.py:234
#: app/partner/routes.py:685
#, python-format

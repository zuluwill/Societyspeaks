msgstr "लिंक और QR कोड पाएँ"

#: app/consultations/emails.py:101 app/consultations/emails.py:102
msgid "The first responses are in"
msgstr "पहली प्रतिक्रियाएँ आ गई हैं"

#: app/consultations/emails.py:105 app/consultations/emails.py:151
#: app/templates/consultations/dashboard.html:66
#, python-format

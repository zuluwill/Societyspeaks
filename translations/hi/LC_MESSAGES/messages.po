msgstr "कम से कम एक webhook ईवेंट प्रकार चुनें।"

#: app/partner/routes.py:1930
#, python-format
msgid "Could not create webhook secret (%(exc)s). Check ENCRYPTION_KEY."
msgstr "Webhook गुप्त नहीं बना सके (%(exc)s)। ENCRYPTION_KEY जांचें।"


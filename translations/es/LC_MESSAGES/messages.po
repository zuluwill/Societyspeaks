msgstr ""
"<strong>Cola de Moderación:</strong> Los propietarios de la discusión pueden"
" revisar el contenido reportado"

#: app/templates/help/native_system.html:365
msgid ""
"<strong>Rate Limits:</strong> 30 votes per minute, 10 statements per hour"
msgstr ""
"<strong>Límites de Velocidad:</strong> 30 votos por minuto, 10 declaraciones"
" por hora"

#: app/templates/help/native_system.html:368
msgid ""
"<strong>Audit Logs:</strong> All moderation actions are tracked for "
"transparency"
msgstr ""
"<strong>Registros de Auditoría:</strong> Todas las acciones de moderación se"
" rastrean para transparencia"

#: app/templates/help/native_system.html:376

msgstr "Nuestro patronato"

#: app/templates/consultations/question.html:31
#: app/templates/daily/results.html:201
msgid "Community"
msgstr "Comunidad"

#: app/templates/consultations/question.html:31
msgid "What would most improve life in our area?"
msgstr "¿Qué mejoraría más la vida en nuestra zona?"

#: app/templates/consultations/question.html:31
msgid "Local residents"
msgstr "Vecinos de la zona"


msgstr "Toda la plantilla"

#: app/templates/consultations/question.html:28
msgid "Event"
msgstr "Evento"

#: app/templates/consultations/question.html:28
msgid "What should this sector do differently after today?"
msgstr "¿Qué debería hacer de otra manera este sector a partir de hoy?"

#: app/templates/consultations/question.html:28

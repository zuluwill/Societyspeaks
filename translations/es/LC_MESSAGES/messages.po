msgstr "%(total)d artículos de %(sources)s fuentes con contenido hoy"

#: app/templates/news/dashboard.html:20
msgid "We monitor 140+ sources daily across the political spectrum"
msgstr "Monitoreamos 140+ fuentes diariamente en todo el espectro político"

#: app/templates/news/dashboard.html:35
msgid "Get the Daily Brief by email"
msgstr "Recibe el Resumen Diario por correo electrónico"


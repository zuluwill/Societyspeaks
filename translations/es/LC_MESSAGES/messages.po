msgid ""
"<a href=\"%(url)s\" class=\"underline hover:text-white\">Choose time zone "
"and delivery time</a> on the full sign-up page."
msgstr ""
"<a href=\"%(url)s\" class=\"underline hover:text-white\">Elige tu zona "
"horaria y hora de entrega</a> en la página de registro completo."

#: app/templates/news/dashboard.html:60 app/templates/news/landing.html:54
msgid "Today's Coverage Balance"
msgstr "Balance de Cobertura de Hoy"

#: app/templates/news/dashboard.html:106
msgid "Search by headline, summary, or source..."
msgstr "Busca por titular, resumen o fuente..."


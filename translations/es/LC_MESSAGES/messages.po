msgstr "Asistentes al congreso"

#: app/templates/consultations/question.html:29
msgid "Customers"
msgstr "Clientes"

#: app/templates/consultations/question.html:29
msgid "What should we improve first?"
msgstr "¿Qué deberíamos mejorar primero?"

#: app/templates/consultations/question.html:29
msgid "Our customers"
msgstr "Nuestros clientes"

#: app/templates/consultations/question.html:30
msgid "Trustees"
msgstr "Patronos"

#: app/templates/consultations/question.html:30

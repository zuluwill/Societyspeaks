msgid "Share this report"
msgstr "Compartir este informe"

#: app/templates/consultations/report.html:55
msgid ""
"Anyone with this link can read the report. They cannot see who took part."
msgstr ""
"Cualquiera que tenga este enlace puede leer el informe. No puede ver quién "
"participó."

#: app/templates/consultations/report.html:58
msgid "Report link"
msgstr "Enlace del informe"


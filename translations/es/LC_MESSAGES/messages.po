msgid "Found %(count)d result(s) for \"<strong>%(term)s</strong>\""
msgstr "Se encontraron %(count)d resultado(s) para \"<strong>%(term)s</strong>\""

#: app/templates/news/dashboard.html:144
#, python-format
msgid "Left (%(count)d)"
msgstr "Izquierda (%(count)d)"

#: app/templates/news/dashboard.html:150
#, python-format
msgid "Centre (%(count)d)"
msgstr "Centro (%(count)d)"

#: app/templates/news/dashboard.html:156
